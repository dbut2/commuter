package web

templ SettingsPage(parkrunID string, segments []SegmentRow, saved bool, n Nav) {
	@shell("Settings", n) {
		<div class="path">
			<h1>settings</h1>
			if saved {
				<p class="notice"><span class="led on"></span>saved</p>
			}
		</div>
		<section class="sec">
			<h2>parkrun</h2>
			<p>Your parkrun athlete ID, the A-number on your barcode. Rules that use <code>{ "{parkrun.*}" }</code> tokens are skipped until it's set.</p>
			<form class="inline-form" method="post" action="/settings/parkrun">
				<input class="input mono short" name="parkrun_id" aria-label="parkrun athlete ID" value={ parkrunID } placeholder="A1234567" pattern="[Aa]?[0-9]*" title="A followed by digits, or empty to disconnect"/>
				<button class="btn">save</button>
			</form>
		</section>
		<section class="sec">
			<h2>segments</h2>
			<p>Strava segments to count laps of. Each adds a <code>{ "{segments.name_count}" }</code> field, the number of efforts on that segment in an activity.</p>
			<table class="tbl">
				<tbody>
					for _, s := range segments {
						<tr>
							<td class="mono grow"><b>{ s.Name }</b></td>
							<td class="mono small">{ s.SegmentID }</td>
							<td><button class="btn quiet stop" form="segment-del" name="name" value={ s.Name } onclick="return confirm('Delete this segment?')">delete</button></td>
						</tr>
					}
					<tr class="add">
						<td class="grow"><input class="input mono" form="segment-add" name="name" aria-label="name" placeholder="albert_park" required pattern="[a-zA-Z0-9_]+" title="letters, digits and underscores"/></td>
						<td class="grow"><input class="input mono" form="segment-add" name="segment_id" aria-label="segment ID" placeholder="6408668" required pattern="[0-9]+" title="the number in strava.com/segments/…"/></td>
						<td><button class="btn" form="segment-add">add</button></td>
					</tr>
				</tbody>
			</table>
			<form id="segment-add" method="post" action="/settings/segments"></form>
			<form id="segment-del" method="post" action="/settings/segments/delete"></form>
		</section>
		<section class="sec">
			<h2>account</h2>
			<div class="bar">
				<form class="inline" method="post" action="/logout"><button class="btn">log out</button></form>
				<form class="inline" method="post" action="/account/delete"><button class="btn quiet stop" onclick="return confirm('Delete your account and all its data? This cannot be undone.')">delete account</button></form>
			</div>
		</section>
	}
}
