package web

import "strconv"

templ DashboardPage(d Dashboard, n Nav) {
	@shell("Activities", n) {
		<div class="path">
			<h1>activities</h1>
			<form class="inline" method="post" action="/activities/sync">
				<button class="btn">sync from strava →</button>
			</form>
		</div>
		<div class="cols">
			<section class="sec">
				<h2>show</h2>
				<div class="views">
					<a href="/activities" { current(d.Filter == "")... }>all</a>
					<a href="/activities?status=pending" { current(d.Filter == "pending")... }>pending <em>({ strconv.Itoa(d.PendingCount) })</em></a>
					<a href="/activities?status=failed" { current(d.Filter == "failed")... }>failed <em>({ strconv.Itoa(d.FailedCount) })</em></a>
				</div>
			</section>
		</div>
		<div class="rows">
			if len(d.Cards) == 0 {
				<p class="empty">No activities here yet. Uploads arrive via the Strava webhook and show up as they're processed.</p>
			}
			for _, a := range d.Cards {
				@activityRow(a)
			}
		</div>
	}
}

templ activityRow(a ActivityCard) {
	<a class="row" href={ templ.URL("/activities/" + a.ID) }>
		<span class={ "led " + a.Status } title={ a.Status }></span>
		<div>
			<div class="name">{ a.Name }</div>
			<div class="meta">{ a.Meta }</div>
		</div>
		if len(a.Rules) == 0 {
			<div class="fired none">no rules matched</div>
		} else {
			<div class="fired">{ joinRules(a.Rules) }</div>
		}
		<div class="when">
			<span>{ a.When }</span>
			if a.Note != "" {
				<span class={ a.Status }>{ a.Note }</span>
			}
		</div>
	</a>
}
