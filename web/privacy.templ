package web

import "dbut.dev/x/kit"

templ PrivacyPage() {
	@kit.Document("Privacy | commuter") {
		@kit.Page(kit.WidthNarrow) {
			@kit.Title("Privacy")
			@kit.T("Last updated 16 October 2026", kit.TextOpts{SM: true, Faint: true, Block: true})
			@privacySection("What's stored") {
				@kit.Stack(2) {
					@kit.Span() {
						Your Strava profile, and the access tokens Strava issues so commuter can update your activities.
					}
					@kit.Span() {
						The rules and settings you create.
					}
					@kit.Span() {
						Details of the activities your rules run on, including where they start and finish, and related information from other services, such as place names or event results.
					}
				}
			}
			@privacySection("How it's used") {
				@kit.Span() {
					Your data is used only to apply your rules to your own activities and to show you the results. It isn't sold or used for advertising, and there's no analytics or tracking.
				}
			}
			@privacySection("Who else sees it") {
				@kit.Stack(2) {
					@kit.Span() {
						Strava, to read your activities and apply your rules' changes to them.
					}
					@kit.Span() {
						Lookup services your rules use, such as place names or event results. Each receives only what its lookup needs, for example an activity's location or an ID you've provided.
					}
				}
			}
			@privacySection("Cookies") {
				@kit.Span() {
					Only those needed to keep you signed in.
				}
			}
			@privacySection("Deleting your data") {
				@kit.Span() {
					Deleting your account in Settings, or revoking access in Strava, removes everything listed above immediately. Changes already made to your activities on Strava remain.
				}
			}
		}
	}
}

templ privacySection(title string) {
	@kit.Card() {
		@kit.CardBody(kit.BodyOpts{Pad: 5, Gap: 2}) {
			@kit.SectionLabel(title)
			@kit.Muted() {
				{ children... }
			}
		}
	}
}
