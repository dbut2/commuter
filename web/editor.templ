package web

templ EditorPage(e Editor, n Nav) {
	@shell(editorTitle(e), n) {
		if e.Error != "" {
			<p class="notice err"><span class="led failed"></span>{ e.Error }</p>
		}
		<form class="form" method="post" action={ templ.URL("/rules/save?id=" + e.ID) }>
			<div class="path">
				<h1 class="named"><a href="/rules">rules</a><i>/</i><input class="title-input" name="name" value={ e.Name } placeholder="rule name" aria-label="name" required/></h1>
				<label class="switch"><input type="checkbox" name="enabled" checked?={ e.Enabled }/> enabled</label>
			</div>
			<section class="sec">
				<h2>when all of these match</h2>
				<div class="stack">
					<div id="conds" class="stack">
						for _, c := range e.Conds {
							@CondRow(e.Catalog, c)
						}
					</div>
					<button type="button" class="btn" hx-get="/rules/rows/cond" hx-target="#conds" hx-swap="beforeend">+ condition</button>
				</div>
			</section>
			<section class="sec">
				<h2>then</h2>
				<div class="stack">
					<div id="acts" class="stack">
						for _, a := range e.Acts {
							@ActRow(a)
						}
					</div>
					<button type="button" class="btn" hx-get="/rules/rows/act" hx-target="#acts" hx-swap="beforeend">+ action</button>
				</div>
			</section>
			@TokenRef(e.Catalog)
			<div class="bar">
				<button class="btn go">save rule →</button>
				<a class="btn quiet" href="/rules">cancel</a>
				<span class="grow"></span>
				if e.ID != "" {
					<button class="btn quiet stop" formaction={ templ.URL("/rules/delete?id=" + e.ID) } formnovalidate onclick="return confirm('Delete this rule?')">delete</button>
				}
			</div>
		</form>
		<datalist id="var-tokens">
			for _, v := range varTokens(e.Catalog) {
				<option value={ v }></option>
			}
		</datalist>
		@tokenScript()
	}
}

func editorTitle(e Editor) string {
	if e.ID == "" {
		return "New rule"
	}
	return e.Name
}

templ CondRow(catalog []Provider, c CondRowVM) {
	{{ f, _ := FindField(catalog, c.Field) }}
	{{ op := findOp(f, c.Op) }}
	<div class="cond-row">
		<select class="select mono" name="cond_field" aria-label="field" hx-get="/rules/rows/cond" hx-include="closest .cond-row" hx-target="closest .cond-row" hx-swap="outerHTML">
			for _, p := range catalog {
				if len(p.Fields) > 0 {
					<optgroup label={ p.Name }>
						for _, pf := range p.Fields {
							<option selected?={ p.Name+"."+pf.Key == c.Field }>{ p.Name + "." + pf.Key }</option>
						}
					</optgroup>
				}
			}
		</select>
		<select class="select" name="cond_op" aria-label="operator" hx-get="/rules/rows/cond" hx-include="closest .cond-row" hx-target="closest .cond-row" hx-swap="outerHTML">
			for _, o := range f.Ops {
				<option value={ o.Name } selected?={ o.Name == op.Name }>{ o.Label }</option>
			}
		</select>
		@condValue(f, op, c.Value)
		<button type="button" class="x" aria-label="remove" onclick="this.closest('.cond-row').remove()">✕</button>
	</div>
}

templ condValue(f Field, op Op, value string) {
	if op.Multi {
		<input class="input mono" name="cond_value" aria-label="value" value={ value } placeholder="comma, separated, values"/>
	} else {
		switch f.Kind {
			case "enum":
				@valueSelect(f.Values, value)
			case "bool":
				@valueSelect([]string{"true", "false"}, boolSel(value))
			case "coords":
				<input class="input mono" name="cond_value" aria-label="value" value={ value } placeholder="{vars.home} 300m" list="var-tokens" title="a coords value or variable, with an optional radius (default 300m)"/>
			default:
				<input class="input mono" name="cond_value" aria-label="value" value={ value } placeholder={ f.Example } list="var-tokens"/>
		}
	}
}

templ valueSelect(values []string, selected string) {
	<select class="select" name="cond_value" aria-label="value">
		for _, v := range values {
			<option selected?={ v == selected }>{ v }</option>
		}
	</select>
}

templ ActRow(a ActRowVM) {
	{{ opt := findAct(a.Key) }}
	<div class="act-row">
		<select class="select" name="act_key" aria-label="action" hx-get="/rules/rows/act" hx-include="closest .act-row" hx-target="closest .act-row" hx-swap="outerHTML">
			for _, o := range ActOptions {
				<option value={ o.Key } selected?={ o.Key == a.Key }>{ o.Label }</option>
			}
		</select>
		if opt.Bool {
			<select class="select" name="act_template" aria-label="value">
				<option selected?={ boolSel(a.Template) == "true" }>true</option>
				<option selected?={ boolSel(a.Template) == "false" }>false</option>
			</select>
		} else {
			<input class="input mono template-input" name="act_template" aria-label="template" value={ a.Template } placeholder="{parkrun.event_name} #{parkrun.event_number}" title="\n inserts a line break in descriptions"/>
		}
		<button type="button" class="x" aria-label="remove" onclick="this.closest('.act-row').remove()">✕</button>
	</div>
}

templ TokenRef(catalog []Provider) {
	<div class="tokens">
		for _, p := range catalog {
			if len(p.Fields) > 0 {
				<section class="sec">
					<h2>
						{ p.Name }
						if p.Note != "" {
							<span>({ p.Note })</span>
						}
					</h2>
					<dl>
						for _, f := range p.Fields {
							<div class="kv"><dt><button type="button" data-token={ "{" + p.Name + "." + f.Key + "}" }>{ "{" + p.Name + "." + f.Key + "}" }</button></dt><dd>{ f.Example }</dd></div>
						}
					</dl>
				</section>
			}
		}
	</div>
}

templ tokenScript() {
	<script>
		let lastTemplateInput = null;
		document.addEventListener('focusin', (e) => {
			if (e.target.classList && e.target.classList.contains('template-input')) lastTemplateInput = e.target;
		});
		document.addEventListener('click', (e) => {
			const b = e.target.closest('[data-token]');
			if (!b) return;
			const el = lastTemplateInput || document.querySelector('.template-input');
			if (!el) return;
			const start = el.selectionStart ?? el.value.length;
			const end = el.selectionEnd ?? start;
			el.value = el.value.slice(0, start) + b.dataset.token + el.value.slice(end);
			el.focus();
			el.selectionStart = el.selectionEnd = start + b.dataset.token.length;
		});
	</script>
}
