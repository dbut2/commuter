package web

templ ActivityDetailPage(a ActivityPage, n Nav) {
	@shell(a.Name, n) {
		<div class="path">
			<h1><a href="/activities">activities</a><i>/</i>{ a.Name }</h1>
			<form class="inline" method="post" action={ templ.URL("/activities/" + a.ID + "/rerun") }>
				<button class="btn go">re-run rules →</button>
			</form>
		</div>
		<div class="cols">
			<section class="sec">
				<h2>activity</h2>
				<dl>
					for _, f := range a.Facts {
						@kv(f[0], f[1])
					}
				</dl>
			</section>
			<section class="sec">
				<h2>status</h2>
				<dl>
					<div class="kv"><dt>state</dt><dd><span class={ "led " + a.Status }></span>{ a.Status }</dd></div>
					switch a.JobStatus {
						case "queued":
							@kv("next poll", a.NextRun)
							@kv("gives up", a.ExpiresAt)
						case "retrying":
							@kv("retrying", a.NextRun)
							@kv("last error", a.JobError)
						case "failed":
							@kv("error", a.JobError)
					}
				</dl>
			</section>
			<section class="sec">
				<h2>open</h2>
				<div class="links">
					<a href={ templ.URL(stravaURL(a.StravaID)) } target="_blank" rel="noopener">→ View on Strava</a>
				</div>
			</section>
		</div>
		<section class="sec">
			<h2>run log</h2>
			<div class="log">
				if len(a.RunLog) == 0 {
					<p class="empty">Not processed yet.</p>
				}
				for _, r := range a.RunLog {
					<div><span class={ "led " + r.Status }></span><span>{ r.Rule }</span><span class="why">{ runNote(r) }</span></div>
				}
			</div>
		</section>
		<div class="cols two">
			for _, p := range a.Providers {
				@providerData(p)
			}
		</div>
	}
}

templ kv(k, v string) {
	<div class="kv"><dt>{ k }</dt><dd>{ v }</dd></div>
}

templ providerData(p ProviderData) {
	<section class="sec">
		<h2>
			if p.Found {
				<span class="led found"></span>
			} else {
				<span class="led pending"></span>
			}
			{ p.Provider }
			<small>fetched { p.FetchedAt }</small>
		</h2>
		if len(p.Data) == 0 {
			<p class="empty">Nothing yet.</p>
		}
		<dl>
			for _, d := range p.Data {
				<div class="kv"><dt>{ d[0] }</dt><dd class="mono">{ d[1] }</dd></div>
			}
		</dl>
	</section>
}
