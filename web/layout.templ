package web

import "dbut.dev/x/kit"

templ LoginPage() {
	@kit.Document("commuter") {
		@kit.Center() {
			@kit.CardNarrow() {
				@kit.CardBody(kit.BodyOpts{Gap: 3, Center: true}) {
					@kit.Title("commuter")
					@kit.Muted() {
						Rules that tidy up your Strava activities as they upload — commutes, parkruns, challenge totals.
					}
					@kit.Form(kit.FormOpts{Action: "/connect"}) {
						<button class="cursor-pointer">
							<img src="/static/btn_strava_connect_with_orange.svg" alt="Connect with Strava" width="237" height="48"/>
						</button>
					}
					<img src="/static/api_logo_pwrdBy_strava_horiz_black.svg" alt="Powered by Strava" class="h-3 w-auto"/>
					@kit.LinkButton("Privacy", "/privacy", kit.BtnOpts{Ghost: true, Size: kit.XS})
				}
			}
		}
	}
}
