package web

templ VarsPage(vars []VarRow, n Nav) {
	@shell("Variables", n) {
		<div class="path">
			<h1>variables</h1>
			<p>Named values for rule conditions, or <code>{ "{vars.name}" }</code> in templates. Coords variables work with <code>is near</code>.</p>
		</div>
		<section class="sec">
			<table class="tbl">
				<thead>
					<tr><th>name</th><th>type</th><th>value</th><th>used</th><th></th></tr>
				</thead>
				<tbody>
					for _, v := range vars {
						<tr>
							<td class="mono grow"><b>{ v.Name }</b></td>
							<td class="small">{ v.Type }</td>
							<td class="mono wide">{ v.Value }</td>
							<td class="small">{ v.Used }</td>
							<td><button class="btn quiet stop" form="var-del" name="name" value={ v.Name } onclick="return confirm('Delete this variable?')">delete</button></td>
						</tr>
					}
					<tr class="add">
						<td class="grow"><input class="input mono" form="var-add" name="name" aria-label="name" placeholder="name" required pattern="[a-zA-Z0-9_]+" title="letters, digits and underscores"/></td>
						<td>
							<select class="select mono" form="var-add" name="type" aria-label="type">
								for _, t := range VarTypes {
									<option selected?={ t == "coords" }>{ t }</option>
								}
							</select>
						</td>
						<td colspan="2" class="wide"><input class="input mono" form="var-add" name="value" aria-label="value" placeholder="-37.84, 144.97" required/></td>
						<td><button class="btn" form="var-add">add</button></td>
					</tr>
				</tbody>
			</table>
		</section>
		<form id="var-add" method="post" action="/vars"></form>
		<form id="var-del" method="post" action="/vars/delete"></form>
	}
}
