package web

templ RulesPage(rules []RuleRow, n Nav) {
	@shell("Rules", n) {
		<div class="path">
			<h1>rules</h1>
			<a class="btn go" href="/rules/edit">new rule →</a>
			<p>Rules run top to bottom, so later rules see earlier edits.</p>
		</div>
		<section class="sec">
			<table class="tbl">
				<thead>
					<tr><th class="narrow">order</th><th class="narrow">on</th><th>rule</th><th>then</th><th></th></tr>
				</thead>
				<tbody>
					if len(rules) == 0 {
						<tr><td colspan="5" class="small">No rules yet. Each one runs on every new upload.</td></tr>
					}
					for i, r := range rules {
						<tr>
							<td class="narrow">
								<form class="order" method="post" action="/rules/move">
									<input type="hidden" name="id" value={ r.ID }/>
									<button class="btn" name="dir" value="up" aria-label="move up" disabled?={ i == 0 }>↑</button>
									<button class="btn" name="dir" value="down" aria-label="move down" disabled?={ i == len(rules)-1 }>↓</button>
								</form>
							</td>
							<td class="narrow">
								<input type="checkbox" class="dot" aria-label="enabled" checked?={ r.Enabled } hx-post={ "/rules/toggle?id=" + r.ID } hx-swap="none"/>
							</td>
							<td class="grow">
								<div class={ "name", templ.KV("off", !r.Enabled) }>{ r.Name }</div>
								<div class="meta">{ r.When }</div>
							</td>
							<td class="small wide">{ r.Then }</td>
							<td><a class="btn quiet" href={ templ.URL("/rules/edit?id=" + r.ID) }>edit →</a></td>
						</tr>
					}
				</tbody>
			</table>
		</section>
	}
}
